rder-radius:14px}.ed-skel span[data-v-5d2c931b]{border-radius:var(--r);background-color:var(--tint);background-image:var(--tintpat);min-height:300px;display:block}.proof[data-v-5d2c931b]{gap:var(--s2) var(--s5);color:var(--ink-2);flex-wrap:wrap;margin:0;padding:0;font-size:.95rem;list-style:none;display:flex}.proof strong[data-v-5d2c931b]{color:var(--ink)}</style><link rel="stylesheet" href="./05-cloudfront-terminal-test_files/entry.1iUpKEB8.css" crossorigin=""><link rel="stylesheet" href="./05-cloudfront-terminal-test_files/ToolHero.B_2QNPsF.css" crossorigin=""><link rel="preload" as="fetch" crossorigin="anonymous" href="https://blurshot.io/_payload.json?_b=a0bc2086-2a0b-4616-a076-27adb4c0f2af"><link rel="modulepreload" as="script" crossorigin="" href="./05-cloudfront-terminal-test_files/DdeIO-HB.js.download"><link rel="modulepreload" as="script" crossorigin="" href="https://blurshot.io/_nuxt/ChqId7pP.js"><link rel="modulepreload" as="script" crossorigin="" href="https://blurshot.io/_nuxt/BZyxyXGs.js"><link rel="modulepreload" as="script" crossorigin="" href="https://blurshot.io/_nuxt/DZnmwl-3.js"><link rel="modulepreload" as="script" crossorigin="" href="https://blurshot.io/_nuxt/cqwHXool.js"><link rel="modulepreload" as="script" crossorigin="" href="https://blurshot.io/_nuxt/DlNR_S1E.js"><link rel="modulepreload" as="script" crossorigin="" href="https://blurshot.io/_nuxt/BRXfZXWs.js"><link rel="modulepreload" as="script" crossorigin="" href="https://blurshot.io/_nuxt/RcUr6uwJ.js"><script type="module" src="./05-cloudfront-terminal-test_files/DdeIO-HB.js.download" crossorigin=""></script><meta name="theme-color" content="#5b2bb5"><link rel="icon" type="image/svg+xml" href="https://blurshot.io/favicon.svg"><link rel="canonical" href="https://blurshot.io/pixelate-image"><meta name="description" content="Pixelate part of an image or the whole picture in your browser. Adjustable block size, no upload, no watermark, metadata removed on download."><meta property="og:title" content="Pixelate Image Online: Pixelate Part of a Picture Free · BlurShot"><meta property="og:description" content="Pixelate part of an image or the whole picture in your browser. Adjustable block size, no upload, no watermark, metadata removed on download."><meta property="og:url" content="https://blurshot.io/pixelate-image"><meta property="og:type" content="website"><meta property="og:site_name" content="BlurShot"><meta name="twitter:card" content="summary"><link rel="stylesheet" crossorigin="" href="./05-cloudfront-terminal-test_files/pages.gbxfSNds.css"><link rel="stylesheet" crossorigin="" href="./05-cloudfront-terminal-test_files/default.BMT2aSJP.css"><link rel="modulepreload" as="script" crossorigin="" href="https://blurshot.io/_nuxt/svDr3ehT.js"><link rel="stylesheet" crossorigin="" href="./05-cloudfront-terminal-test_files/pixelate-image.CecH9ucs.css"><link rel="modulepreload" as="script" crossorigin="" href="https://blurshot.io/_nuxt/COA2oLu0.js"><link rel="modulepreload" as="script" crossorigin="" href="https://blurshot.io/_nuxt/B145fP2_.js"><link rel="modulepreload" as="script" crossorigin="" href="https://blurshot.io/_nuxt/gbpG_cAy.js"><link rel="modulepreload" as="script" crossorigin="" href="https://blurshot.io/_nuxt/cAqoLk6k.js"><link rel="stylesheet" crossorigin="" href="./05-cloudfront-terminal-test_files/remove-exif-data.Db4k_os6.css"><link rel="modulepreload" as="script" crossorigin="" href="https://blurshot.io/_nuxt/DnjJ0ujo.js"><link rel="stylesheet" crossorigin="" href="./05-cloudfront-terminal-test_files/unblur-image.BjjyOCA3.css"><link rel="modulepreload" as="script" crossorigin="" href="https://blurshot.io/_nuxt/Dw_f40wO.js"><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"WebApplication","name":"Pixelate image online","url":"https://blurshot.io/pixelate-image","description":"Pixelate part of an image or the whole picture in your browser. Adjustable block size, no upload, no watermark, metadata removed on download.","applicationCategory":"MultimediaApplication","operatingSystem":"Any (runs in the browser)","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"isAccessibleForFree":true},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"BlurShot","item":"https://blurshot.io/"},{"@type":"ListItem","position":2,"name":"Pixelate image online","item":"https://blurshot.io/pixelate-image"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do I pixelate only part of an image?","acceptedAnswer":{"@type":"Answer","text":"Open the image, keep Pixelate selected and drag a box over the area. Each box keeps its own block size, so you can pixelate a face heavily and a background sign lightly in the same picture."}},{"@type":"Question","name":"How do I pixelate the whole image?","acceptedAnswer":{"@type":"Answer","text":"Press \"Whole image\" after opening it. That adds one box covering every pixel, and the strength slider then sets the block size for the entire picture."}},{"@type":"Question","name":"What block size is enough?","acceptedAnswer":{"@type":"Answer","text":"For faces, blocks about a fifth of the face width make it unrecognisable to people. For text, pixelation is never guaranteed: short strings in a known font can be guessed back. Use a solid box for numbers and passwords."}},{"@type":"Question","name":"Is pixelation the same as a mosaic effect?","acceptedAnswer":{"@type":"Answer","text":"Yes. \"Mosaic\" is the name many photo apps use for the same block-averaging filter."}},{"@type":"Question","name":"Will the pixelated file still contain the original?","acceptedAnswer":{"@type":"Answer","text":"No. The export is a new image drawn from the edited pixels, with no layers, undo history or metadata. Anyone receiving it gets only what you see."}}]}]}</script></head><body><div id="__nuxt"><div class="site" data-v-a9d23265=""><a class="skip" href="https://blurshot.io/pixelate-image#main" data-v-a9d23265="">Skip to content</a><header class="top" data-v-a9d23265=""><div class="wrap top-in" data-v-a9d23265=""><a href="https://blurshot.io/" class="logo" aria-label="BlurShot home" data-v-a9d23265=""><svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true" data-v-a9d23265=""><rect width="32" height="32" rx="7" fill="currentColor" data-v-a9d23265=""></rect><rect x="6" y="9" width="20" height="5" rx="1" fill="#fff" data-v-a9d23265=""></rect><rect x="6" y="18" width="14" height="5" rx="1" fill="#141019" data-v-a9d23265=""></rect></svg><span data-v-a9d23265="">Blur<span class="bar" data-v-a9d23265="">Shot</span></span></a><button type="button" class="menu-btn" aria-expanded="false" aria-controls="nav" data-v-a9d23265="">Menu</button><nav id="nav" class="" aria-label="Tools" data-v-a9d23265=""><!--[--><a href="https://blurshot.io/" class="" data-v-a9d23265="">Blur</a><a href="https://blurshot.io/pixelate-image" class="router-link-active router-link-exact-active" data-v-a9d23265="" aria-current="page">Pixelate</a><a href="https://blurshot.io/redact-image" class="" data-v-a9d23265="">Redact</a><a href="https://blurshot.io/blur-face" class="" data-v-a9d23265="">Faces</a><a href="https://blurshot.io/blur-license-plate" class="" data-v-a9d23265="">Plates</a><a href="https://blurshot.io/remove-exif-data" class="" data-v-a9d23265="">EXIF</a><!--]--></nav></div></header><main id="main" data-v-a9d23265=""><!--[--><div><section data-v-5d2c931b="" class="hero"><div data-v-5d2c931b="" class="wrap th"><div data-v-5d2c931b="" class="th-copy"><h1>Pixelate image online</h1><p class="lede">Turn faces, names or number plates into chunky blocks. Pixelate one area or the whole picture, set the block size per box, and download. Your photo stays on your device.</p></div><div data-v-e2cd6ea8="" data-v-5d2c931b="" class="ed has"><div data-v-e2cd6ea8="" class="toolbar" role="toolbar" aria-label="Redaction tools"><div data-v-e2cd6ea8="" class="seg" role="radiogroup" aria-label="Effect"><button data-v-e2cd6ea8="" type="button" role="radio" aria-checked="false" class="">Blur</button><button data-v-e2cd6ea8="" type="button" role="radio" aria-checked="true" class="on">Pixelate</button><button data-v-e2cd6ea8="" type="button" role="radio" aria-checked="false" class="">Solid box</button><button data-v-e2cd6ea8="" type="button" role="radio" aria-checked="false" class="">Emoji</button></div><label data-v-e2cd6ea8="" class="slider"><span data-v-e2cd6ea8="">Block strength</span><input data-v-e2cd6ea8="" type="range" min="5" max="100"></label><!----><!----></div><p data-v-e2cd6ea8="" class="hint">Drag on the image to cover an area. Drag a box to move it, its corner to resize. </p><div data-v-e2cd6ea8="" class="canvas-wrap"><div data-v-e2cd6ea8="" class="stage" style="aspect-ratio: 769 / 223; width: min(100%, 248.287vh);"><canvas data-v-e2cd6ea8="" width="769" height="223" role="img" aria-label="Preview of Screenshot 2026-09-28 130023 with 7 redacted area(s)"></canvas><div data-v-e2cd6ea8="" class="reg" data-id="9" style="left: 17.9204%; top: 81.2837%; width: 19.823%; height: 4.27257%;"><!----><span data-v-e2cd6ea8="" class="handle" data-handle="1" aria-hidden="true"></span></div><div data-v-e2cd6ea8="" class="reg" data-id="11" style="left: 19.6903%; top: 68.7712%; width: 17.3451%; height: 4.88293%;"><!----><span data-v-e2cd6ea8="" class="handle" data-handle="1" aria-hidden="true"></span></div><div data-v-e2cd6ea8="" class="reg" data-id="12" style="left: 13.8496%; top: 37.0321%; width: 12.5664%; height: 3.6622%;"><!----><span data-v-e2cd6ea8="" class="handle" data-handle="1" aria-hidden="true"></span></div><div data-v-e2cd6ea8="" class="reg" data-id="14" style="left: 28.7168%; top: 43.4409%; width: 3.27434%; height: 4.88293%;"><!----><span data-v-e2cd6ea8="" class="handle" data-handle="1" aria-hidden="true"></span></div><div data-v-e2cd6ea8="" class="reg" data-id="16" style="left: 43.4071%; top: 92.8806%; width: 7.69911%; height: 4.57775%;"><!----><span data-v-e2cd6ea8="" class="handle" data-handle="1" aria-hidden="true"></span></div><div data-v-e2cd6ea8="" class="reg" data-id="17" style="left: 49.6903%; top: 80.3681%; width: 8.58407%; height: 5.4933%;"><!----><span data-v-e2cd6ea8="" class="handle" data-handle="1" aria-hidden="true"></span></div><div data-v-e2cd6ea8="" class="reg sel" data-id="18" style="left: 13.9381%; top: 75.4852%; width: 2.92035%; height: 3.35702%;"><!----><span data-v-e2cd6ea8="" class="handle" data-handle="1" aria-hidden="true"></span></div></div></div><div data-v-e2cd6ea8="" class="actions"><div data-v-e2cd6ea8="" class="row"><button data-v-e2cd6ea8="" type="button" class="btn small">Undo</button><button data-v-e2cd6ea8="" type="button" class="btn small">Delete box</button><button data-v-e2cd6ea8="" type="button" class="btn small">Whole image</button><button data-v-e2cd6ea8="" type="button" class="btn small">Clear all</button><button data-v-e2cd6ea8="" type="button" class="btn small">New image</button></div><div data-v-e2cd6ea8="" class="row"><button data-v-e2cd6ea8="" type="button" class="btn small ai-btn">Find areas with AI</button></div></div><!----><!----><div data-v-e2cd6ea8="" class="list"><h3 data-v-e2cd6ea8="" class="list-h">Covered areas</h3><ul data-v-e2cd6ea8=""><li data-v-e2cd6ea8=""><button data-v-e2cd6ea8="" type="button" class=""><span data-v-e2cd6ea8="" class="num">1.</span> Pixelate<!----><span data-v-e2cd6ea8="" class="dim num">152×10</span></button></li><li data-v-e2cd6ea8=""><button data-v-e2cd6ea8="" type="button" class=""><span data-v-e2cd6ea8="" class="num">2.</span> Pixelate<!----><span data-v-e2cd6ea8="" class="dim num">133×11</span></button></li><li data-v-e2cd6ea8=""><button data-v-e2cd6ea8="" type="button" class=""><span data-v-e2cd6ea8="" class="num">3.</span> Pixelate<!----><span data-v-e2cd6ea8="" class="dim num">97×8</span></button></li><li data-v-e2cd6ea8=""><button data-v-e2cd6ea8="" type="button" class=""><span data-v-e2cd6ea8="" class="num">4.</span> Pixelate<!----><span data-v-e2cd6ea8="" class="dim num">25×11</span></button></li><li data-v-e2cd6ea8=""><button data-v-e2cd6ea8="" type="button" class=""><span data-v-e2cd6ea8="" class="num">5.</span> Pixelate<!----><span data-v-e2cd6ea8="" class="dim num">59×10</span></button></li><li data-v-e2cd6ea8=""><button data-v-e2cd6ea8="" type="button" class=""><span data-v-e2cd6ea8="" class="num">6.</span> Pixelate<!----><span data-v-e2cd6ea8="" class="dim num">66×12</span></button></li><li data-v-e2cd6ea8=""><button data-v-e2cd6ea8="" type="button" class="on"><span data-v-e2cd6ea8="" class="num">7.</span> Pixelate<!----><span data-v-e2cd6ea8="" class="dim num">22×7</span></button></li></ul></div><div data-v-e2cd6ea8="" class="export"><button data-v-e2cd6ea8="" type="button" class="btn primary">Download PNG</button><button data-v-e2cd6ea8="" type="button" class="btn">Download JPEG</button><button data-v-e2cd6ea8="" type="button" class="btn">Copy</button></div><p data-v-e2cd6ea8="" class="fine">Exports are re-drawn from pixels, so EXIF, GPS, camera and editing metadata are not carried over. For passwords, card numbers and IDs, use <strong data-v-e2cd6ea8="">Solid box</strong>: a blur can sometimes be reversed.</p><!----><dialog data-v-e2cd6ea8="" class="dlg" aria-labelledby="ai-h"><form data-v-e2cd6ea8="" method="dialog"><h3 data-v-e2cd6ea8="" id="ai-h">Find sensitive areas with AI?</h3><p data-v-e2cd6ea8="">This is the one feature that leaves your device. A copy of the image, downscaled to at most 1280px, goes to a vision model through Vercel AI Gateway (<code data-v-e2cd6ea8="">google/gemini-3.8-flash</code>). It returns box positions only. We don't store the image; see the <a data-v-e2cd6ea8="" href="https://blurshot.io/privacy" class="">privacy page</a>.</p><fieldset data-v-e2cd6ea8=""><legend data-v-e2cd6ea8="">Look for</legend><label data-v-e2cd6ea8=""><input data-v-e2cd6ea8="" type="checkbox" value="faces"> Faces</label><label data-v-e2cd6ea8=""><input data-v-e2cd6ea8="" type="checkbox" value="plates"> Licence plates</label><label data-v-e2cd6ea8=""><input data-v-e2cd6ea8="" type="checkbox" value="text"> Personal text (emails, numbers, names, IDs)</label></fieldset><p data-v-e2cd6ea8="" class="fine">Don't send images you are not allowed to share with a third party, such as patient records. Draw boxes by hand for those.</p><div data-v-e2cd6ea8="" class="row"><button data-v-e2cd6ea8="" type="submit" class="btn primary">Send and find</button><button data-v-e2cd6ea8="" type="button" class="btn">Cancel</button></div></form></dialog></div><ul data-v-5d2c931b="" class="proof"><li data-v-5d2c931b=""><strong data-v-5d2c931b="">No upload.</strong> Pixels are processed in this tab; open DevTools → Network to check.</li><li data-v-5d2c931b=""><strong data-v-5d2c931b="">No account, no watermark.</strong></li><li data-v-5d2c931b=""><strong data-v-5d2c931b="">Metadata stripped</strong> on every download.</li></ul></div></section><section class="wrap block two"><div class="prose"><h2>What pixelation does to your pixels</h2><p>Pixelating splits the area into square blocks and paints each block with the average colour of the pixels inside it. A 4×4 block turns 16 values into one; an 8×8 block turns 64 into one.</p><p>That is a lot of lost detail, which is why a pixelated face is unrecognisable. But the averages are not random. Two different letters in the same font give two slightly different sets of greys, and an attacker who can guess the font can compare candidates until one matches.</p><p>Move the slider and tap a block to see which pixels were blended into it.</p></div><figure data-v-ca10c6a9="" class="ba"><div data-v-ca10c6a9="" class="ba-top"><label data-v-ca10c6a9="" class="ba-s"><span data-v-ca10c6a9="">Block size <b data-v-ca10c6a9="" class="num">4×4</b> px</span><input data-v-ca10c6a9="" type="range" min="0" max="4" step="1" aria-valuetext="4 by 4 pixels"></label><p data-v-ca10c6a9="" class="ba-k num"><b data-v-ca10c6a9="">256</b> pixel values in → <b data-v-ca10c6a9="">16</b> out</p></div><div data-v-ca10c6a9="" class="ba-grids"><div data-v-ca10c6a9=""><p data-v-ca10c6a9="" class="lab">Original crop</p><div data-v-ca10c6a9="" class="grid" aria-hidden="true"><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255, 255);"></i><i data-v-ca10c6a9="" class="" style="background: rgb(255, 255